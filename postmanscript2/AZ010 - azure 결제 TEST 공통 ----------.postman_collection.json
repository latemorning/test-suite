		{
			"name": "Z04 | 포인트 사용",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"id": "9f31fc34-58de-4a91-9a4f-cb3dd75285e1",
						"exec": [
							"// 고객부담수수료율\r",
							"const shop_cmsn_rate = 0\r",
							"pm.variables.set(\"v_shop_cmsn_rate\", shop_cmsn_rate)\r",
							"\r",
							"// 상품금액 \r",
							"const ttl_pay_amt = 4000\r",
							"pm.variables.set(\"v_ttl_pay_amt\", ttl_pay_amt)\r",
							"\r",
							"/* 각 카드사별 사용포인트\r",
							"    - 사용금액에 따라 아래 배열에서 수정\r",
							"    - 전단계 포인트 조회에서 조회가 되지 않은 카드사는 제외됨\r",
							"    - point를 0으로 하면 해당 카드사 포인트 사용요청 제외됨\r",
							"*/\r",
							"const use_points = [\r",
							"    {\"pnt_cd\": \"bccard\", \"point\": 1000},           // 사용불가 - 통신오류 설정되어있음\r",
							"    {\"pnt_cd\": \"kbpointree\", \"point\": 1000},       // 사용불가 - 30일 이전에만 정정가능 오류남\r",
							"    {\"pnt_cd\": \"shinhan\", \"point\": 0},\r",
							"    {\"pnt_cd\": \"hanamembers\", \"point\": 1000},\r",
							"    {\"pnt_cd\": \"samsungcard\", \"point\": 1000},      // 사용불가 - 매입취소로 오류발생\r",
							"    {\"pnt_cd\": \"hyundaicard\", \"point\": 0},\r",
							"    {\"pnt_cd\": \"lottemembers\", \"point\": 0},\r",
							"    {\"pnt_cd\": \"wooricard\", \"point\": 0},\r",
							"    {\"pnt_cd\": \"nhmembers\", \"point\": 0},        // 사용불가 - 포인트없음(조회안됨)\r",
							"//    {\"pnt_cd\": \"naverpay\", \"point\": 1000},\r",
							"]\r",
							"\r",
							"// 포인트 조회에서 가져온 카드사별 정보 배열\r",
							"const prvdr_list = pm.variables.get(\"v_prvdr_list\")\r",
							"\r",
							"// 각 카드사 사용 point 총합\r",
							"let ttl_pnt = 0\r",
							"prvdr_list.forEach(prvdr => {\r",
							"    const use_point_obj = use_points.filter(use_point => use_point.pnt_cd === prvdr.pnt_cd)\r",
							"    ttl_pnt = ttl_pnt + use_point_obj[0].point\r",
							"})\r",
							"pm.variables.set(\"v_ttl_pnt\", ttl_pnt)\r",
							"\r",
							"// 각 카드사 사용 point_amt 총합\r",
							"let ttl_pnt_amt = 0\r",
							"prvdr_list.forEach(prvdr => {\r",
							"    const use_point_obj = use_points.filter(use_point => use_point.pnt_cd === prvdr.pnt_cd)\r",
							"    ttl_pnt_amt = ttl_pnt_amt + use_point_obj[0].point * prvdr.pnt_exch_rate\r",
							"})\r",
							"pm.variables.set(\"v_ttl_pnt_amt\", ttl_pnt_amt)\r",
							"\r",
							"// 결제할인액\r",
							"let ttl_cprt_amt = ttl_pnt_amt - (ttl_pnt_amt * (shop_cmsn_rate / 100))\r",
							"\r",
							"//ttl_cprt_amt = 450000\r",
							"pm.variables.set(\"v_ttl_cprt_amt\", ttl_cprt_amt)\r",
							"\r",
							"// 잔여금액\r",
							"const ttl_rmnd_amt = ttl_pay_amt - ttl_cprt_amt\r",
							"pm.variables.set(\"v_ttl_rmnd_amt\", ttl_rmnd_amt)\r",
							"//pm.variables.set(\"v_ttl_rmnd_amt\", 0)\r",
							"\r",
							"// 포인트사용 요청 list 생성\r",
							"const req_prvdr_list = prvdr_list.filter(p => use_points.some(u => p.pnt_cd === u.pnt_cd && u.point > 0)).map((prvdr) => {\r",
							"    \r",
							"    const rtn_obj = {}\r",
							"\r",
							"    rtn_obj.pnt_tr_no = prvdr.pnt_tr_no\r",
							"    rtn_obj.pnt_cd = prvdr.pnt_cd\r",
							"    rtn_obj.name = prvdr.pnt_nm\r",
							"\r",
							"    const use_point_obj = use_points.filter(use_point => use_point.pnt_cd === prvdr.pnt_cd)[0]\r",
							"\r",
							"    console.log(JSON.stringify(use_point_obj))\r",
							"\r",
							"    rtn_obj.point = use_point_obj.point\r",
							"    rtn_obj.point_amt = use_point_obj.point * prvdr.pnt_exch_rate\r",
							"\r",
							"    return rtn_obj\r",
							"})\r",
							"pm.variables.set(\"v_req_prvdr_list\", JSON.stringify(req_prvdr_list))\r",
							"\r",
							"// hash ----------\r",
							"const pg_tr_no = pm.variables.get(\"v_pg_tr_no\")\r",
							"const phub_tr_no = pm.variables.get(\"v_phub_tr_no\")\r",
							"const shop_cd = pm.variables.get(\"v_shop_cd\")\r",
							"\r",
							"const hash_source = pg_tr_no + ttl_pnt_amt + shop_cd + phub_tr_no\r",
							"const hash2 = CryptoJS.SHA256(hash_source).toString()\r",
							"\r",
							"console.log(hash_source + '  --  ' + hash2)\r",
							"\r",
							"pm.variables.set(\"v_hash2\", hash2)\r",
							"\r",
							"\r",
							""
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"id": "3be16743-1b87-4c69-8c69-8e73ed345929",
						"exec": [
							"pm.test(\"response is ok\", function(){\r",
							"    let jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.ret_code).to.eql(\"00\")\r",
							"})\r",
							"\r",
							"pm.variables.set(\"v_pay_amt\", pm.response.json().pay_amt)\r",
							"pm.variables.set(\"v_points_amt\", pm.response.json().points_amt)\r",
							"\r",
							"console.log(pm.response.json())"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"name": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Authorization",
						"value": "{{header_auth}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"pg_tr_no\": \"{{v_pg_tr_no}}\",\r\n    \"pg_cd\": \"{{v_pg_cd}}\",\r\n    \"phub_tr_no\": \"{{v_phub_tr_no}}\",\r\n    \"shop_cd\": \"{{v_shop_cd}}\",\r\n    \"pg_cust_ci\": \"{{v_cust_ci}}\",\r\n    \"shop_pay_method\": \"{{v_deal_se}}\",\r\n    \"shop_cmsn_rate\": {{v_shop_cmsn_rate}},\r\n    \"prvdr_list\": {{v_req_prvdr_list}},\r\n    \"check_hash\": \"{{v_hash2}}\",\r\n    \"ttl_pnt\": {{v_ttl_pnt}},\r\n    \"ttl_pay_amt\": {{v_ttl_pay_amt}},\r\n    \"ttl_pnt_amt\": {{v_ttl_pnt_amt}},\r\n    \"ttl_rmnd_amt\": {{v_ttl_rmnd_amt}},\r\n    \"ttl_cprt_amt\": {{v_ttl_cprt_amt}}\r\n}\r\n",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{host}}/api/v1/c/pnt",
					"host": [
